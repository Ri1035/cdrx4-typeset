# build scratch, regenerated by build_gms.vbs / make_installer.ps1
_build_tmp/
*_silent.vbs

# compiled plugin: binary, produced by build_gms.vbs
# (the ready-to-use copy is embedded in dist/安装排版工具.vbs)
dist/TypesetToolkit.gms

# scratch logs and screenshots from dev runs; the curated copies that
# are meant to ship live in logs/
*.log
!logs/*.log
_*.png

# recon artifacts: reference plugin dumps / extracted sources / workspace scan
_ref/
_recon_src/
recon_ws.txt

# staging clone used only for pushing
_push_stage/

# editor / OS noise
Thumbs.db
desktop.ini
